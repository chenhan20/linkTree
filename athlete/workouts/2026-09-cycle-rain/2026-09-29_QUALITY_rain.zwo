<workout_file>
  <author>Training plan</author>
  <name>2026-09-29_QUALITY_rain</name>
  <description>2026-09-29 target 215W on trainer = 215W at crank (no conversion). Crank FTP 234W. Use the stated power source. Device offsets require validation. Adjust effort for recovery and conditions; heart rate alone does not identify the cause. FreeRide cues only: use slope/level and read crank power; no automatic ERG control.</description>
  <sportType>bike</sportType>
  <workout>
    <FreeRide Duration="900" FlatRoad="1"><textevent timeoffset="0" message="warmup: crank 110-160W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="work: crank 215-215W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="300" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 115-115W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="work: crank 215-215W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="300" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 115-115W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="work: crank 215-215W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="1200" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 145-145W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="cooldown: crank 110-110W; adjust for conditions"/></FreeRide>
  </workout>
</workout_file>
