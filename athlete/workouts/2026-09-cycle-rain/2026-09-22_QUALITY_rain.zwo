<workout_file>
  <author>Training plan</author>
  <name>2026-09-22_QUALITY_rain</name>
  <description>2026-09-22 target 212W on trainer = 212W at crank (no conversion). Crank FTP 234W. Use the stated power source. Device offsets require validation. Adjust effort for recovery and conditions; heart rate alone does not identify the cause. FreeRide cues only: use slope/level and read crank power; no automatic ERG control.</description>
  <sportType>bike</sportType>
  <workout>
    <FreeRide Duration="900" FlatRoad="1"><textevent timeoffset="0" message="warmup: crank 110-160W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="1200" FlatRoad="1"><textevent timeoffset="0" message="Self-paced test; finish at segment endpoint"/></FreeRide>
    <FreeRide Duration="360" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 115-115W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="1260" FlatRoad="1"><textevent timeoffset="0" message="work: crank 212-212W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="300" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 115-115W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="1500" FlatRoad="1"><textevent timeoffset="0" message="work: crank 202-202W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="cooldown: crank 110-110W; adjust for conditions"/></FreeRide>
  </workout>
</workout_file>
