<workout_file>
  <author>Training plan</author>
  <name>2026-09-22_ENDURANCE_rain</name>
  <description>2026-09-22 target 208W on trainer = 208W at crank (no conversion). Crank FTP 234W. Use the stated power source. Device offsets require validation. Adjust effort for recovery and conditions; heart rate alone does not identify the cause. FreeRide cues only: use slope/level and read crank power; no automatic ERG control.</description>
  <sportType>bike</sportType>
  <workout>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="warmup: crank 110-145W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="2280" FlatRoad="1"><textevent timeoffset="0" message="work: crank 208-208W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="cooldown: crank 110-110W; adjust for conditions"/></FreeRide>
  </workout>
</workout_file>
