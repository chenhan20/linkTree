<workout_file>
  <author>Training plan</author>
  <name>2026-10-20_QUALITY_outdoor</name>
  <description>2026-10-20 target 225W on trainer = 225W at crank (no conversion). Crank FTP 234W. Use the stated power source. Device offsets require validation. Adjust effort for recovery and conditions; heart rate alone does not identify the cause. FreeRide cues only: use slope/level and read crank power; no automatic ERG control.</description>
  <sportType>bike</sportType>
  <workout>
    <FreeRide Duration="1500" FlatRoad="1"><textevent timeoffset="0" message="warmup: crank 110-160W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="720" FlatRoad="1"><textevent timeoffset="0" message="work: crank 225-225W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="600" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 115-115W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="720" FlatRoad="1"><textevent timeoffset="0" message="work: crank 225-225W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="2460" FlatRoad="1"><textevent timeoffset="0" message="recovery: crank 145-145W; adjust for conditions"/></FreeRide>
    <FreeRide Duration="900" FlatRoad="1"><textevent timeoffset="0" message="cooldown: crank 115-115W; adjust for conditions"/></FreeRide>
  </workout>
</workout_file>
